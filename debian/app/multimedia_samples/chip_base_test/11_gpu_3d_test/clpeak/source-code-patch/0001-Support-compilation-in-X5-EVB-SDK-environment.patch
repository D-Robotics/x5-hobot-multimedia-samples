diff --git a/Readme.md b/Readme.md
new file mode 100644
index 0000000..fecbf49
--- /dev/null
+++ b/Readme.md
@@ -0,0 +1,11 @@
+# 获取源码
+clpeak是开源代码，放到EVB SDK中无法直接编译，需要按照如下步骤操作打上PATCH。
+
+1. 进入上级目录，创建source
+	cd ../ && mkdir source
+2. 拉取代码（指定tag）
+	cd clpeak
+	git clone --branch 1.1.4 --depth 1 https://github.com/krrishnarraj/clpeak.git
+3. patch 文件赋值到源码目录
+   cp ../../0001-Support-compilation-in-X5-EVB-SDK-environment.patch .
+   git am < 0001-Support-compilation-in-X5-EVB-SDK-environment.patch
\ No newline at end of file
diff --git a/cmake/aarch64_toolchain.cmake b/cmake/aarch64_toolchain.cmake
new file mode 100644
index 0000000..256d4c8
--- /dev/null
+++ b/cmake/aarch64_toolchain.cmake
@@ -0,0 +1,12 @@
+set(CMAKE_SYSTEM_NAME Linux)
+set(CMAKE_SYSTEM_PROCESSOR arm)
+
+# 指定交叉编译器路径
+set(CMAKE_C_COMPILER /opt/arm-gnu-toolchain-11.3.rel1-x86_64-aarch64-none-linux-gnu/bin/aarch64-none-linux-gnu-gcc)
+set(CMAKE_CXX_COMPILER /opt/arm-gnu-toolchain-11.3.rel1-x86_64-aarch64-none-linux-gnu/bin/aarch64-none-linux-gnu-g++)
+
+add_compile_options(-Wno-missing-field-initializers)
+
+set(SDK_PATH ${CMAKE_CURRENT_LIST_DIR}/../../../../../../../../out/)
+
+set(X5_3DGPU_OPENCL_TEST_PATH ${CMAKE_CURRENT_LIST_DIR}/../../../)
\ No newline at end of file
