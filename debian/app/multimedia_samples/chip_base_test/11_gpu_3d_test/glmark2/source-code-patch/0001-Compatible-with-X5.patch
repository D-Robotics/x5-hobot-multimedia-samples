+TARGET = libglad.a
+OBJECTS = $(patsubst %.c,%.o,$(SOURCES))
+
+$(TARGET) : $(OBJECTS)
+	$(AR) $(ARFLAG) $@ $^
+
+$(OBJECTS) : %.o : %.c
+	$(CC) -c $(CFLAGS) $< -o $@ $(INCLUDE_DIRS) -D__GBM__
+
+.PHONY : clean
+clean:
+	rm -rf $(TARGET) $(OBJECTS)
