-        that->window_->properties.width = width * scale;
-        that->window_->properties.height = height * scale;
-    } else if (that->window_->properties.fullscreen) {
-        if (want_fullscreen) {
-            that->window_->properties.width = width * scale;
-            that->window_->properties.height = height * scale;
